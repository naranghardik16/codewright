{
    "name": "@codewright/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.1",
        "@ai-sdk/openai": "^4.0.2",
        "@codewright/database": "workspace:*",
        "@codewright/shared": "workspace:*",
        "@hono/zod-validator": "^0.8.0",
        "ai": "^7.0.4",
        "dotenv": "^17.4.2",
        "hono": "^4.12.26",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "bun-types": "latest"
    }
}
